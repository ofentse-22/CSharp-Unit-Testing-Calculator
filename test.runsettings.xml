<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
	<!-- General test settings -->
	<RunConfiguration>
		<MaxCpuCount>0</MaxCpuCount>
		<!-- 0 = use all CPU cores -->
	</RunConfiguration>

	<!-- MSTest-specific settings -->
	<MSTest>
		<Parallelize>
			<Workers>4</Workers>
			<!-- Number of parallel threads -->
			<Scope>MethodLevel</Scope>
			<!-- Parallelize test METHODS -->
		</Parallelize>
		<ClassCleanupLifecycle>EndOfAssembly</ClassCleanupLifecycle>
	</MSTest>
</RunSettings>
